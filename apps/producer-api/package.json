{
  "name": "@lab/producer-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node --env-file=../../.env node_modules/prisma/build/index.js generate && tsc -p tsconfig.build.json",
    "prisma:generate": "node --env-file=../../.env node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest run integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lab/contracts": "workspace:*",
    "@lab/observability": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.4.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.11.11",
    "prisma": "6.4.1"
  }
}
