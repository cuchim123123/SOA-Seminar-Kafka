{
  "name": "kafka-streaming-lab",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,mjs,json}\" --ignore-path .gitignore",
    "build": "pnpm -r --if-present run build",
    "start:producer": "pnpm --filter @lab/producer-api start",
    "start:publisher": "pnpm --filter @lab/outbox-publisher start",
    "start:loyalty": "pnpm --filter @lab/loyalty-worker start",
    "start:analytics": "pnpm --filter @lab/analytics-worker start",
    "start:replay": "pnpm --filter @lab/replay-worker start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest run integration --fileParallelism=false",
    "test:watch": "vitest",
    "kafka:up": "docker compose up -d",
    "kafka:down": "docker compose down",
    "kafka:logs": "docker compose logs -f kafka",
    "kafka:status": "docker compose ps",
    "kafka:verify": "node scripts/verify-kafka.mjs",
    "demo:smoke": "node scripts/smoke-phase1.mjs",
    "demo:smoke:p1": "node scripts/smoke-phase1.mjs",
    "demo:reset": "node scripts/reset-topic.mjs",
    "demo:workload": "node scripts/generate-ordered-workload.mjs",
    "demo:workload:p2": "node scripts/generate-ordered-workload.mjs",
    "demo:partitions": "node scripts/inspect-partitions.mjs",
    "demo:partitions:p2": "node scripts/inspect-partitions.mjs",
    "demo:groups": "node scripts/verify-consumer-groups.mjs",
    "demo:groups:p3": "node scripts/verify-consumer-groups.mjs",
    "demo:lag": "node scripts/verify-lag.mjs",
    "demo:lag:p3": "node scripts/verify-lag.mjs",
    "demo:pause-resume": "node scripts/demo-pause-resume.mjs",
    "demo:pause-resume:p3": "node scripts/demo-pause-resume.mjs",
    "demo:concurrency": "node scripts/verify-postgres-concurrency.mjs",
    "demo:concurrency:p4": "node scripts/verify-postgres-concurrency.mjs",
    "demo:outbox": "node scripts/verify-outbox-offline.mjs",
    "demo:outbox:p4": "node scripts/verify-outbox-offline.mjs",
    "demo:publisher": "node scripts/verify-outbox-publisher.mjs",
    "demo:publisher:p4": "node scripts/verify-outbox-publisher.mjs",
    "demo:loyalty-dedup": "node scripts/verify-durable-loyalty.mjs",
    "demo:loyalty-dedup:p4": "node scripts/verify-durable-loyalty.mjs",
    "demo:analytics-dedup": "node scripts/verify-durable-analytics.mjs",
    "demo:analytics-dedup:p4": "node scripts/verify-durable-analytics.mjs",
    "demo:faults": "node scripts/verify-fault-injection.mjs",
    "demo:fault-injection:p4": "node scripts/verify-fault-injection.mjs",
    "demo:invalidation": "node scripts/verify-purchase-invalidation.mjs",
    "demo:invalidation:p5": "node scripts/verify-purchase-invalidation.mjs",
    "demo:replay": "node scripts/verify-replay-boundary.mjs",
    "demo:replay:p5": "node scripts/verify-replay-boundary.mjs",
    "demo:correction": "node scripts/verify-two-pass-correction.mjs",
    "demo:correction:p5": "node scripts/verify-two-pass-correction.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.18.0",
    "@swc/core": "^1.10.7",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
