# ─────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOYALTY_WORKER_PORT=3001
ANALYTICS_WORKER_PORT=3002
REPLAY_WORKER_PORT=3004

# ─────────────────────────────────────────────────────────────────────────────
# Kafka Infrastructure (P0-02+)
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
KAFKA_CLUSTER_ID=4L622nShTUiAnsYh0-X41w
KAFKA_CLIENT_ID=producer-api
PURCHASE_TOPIC=purchase.events
KAFKA_LOYALTY_GROUP_ID=loyalty-v1
KAFKA_ANALYTICS_GROUP_ID=analytics-v1

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Phase 4+)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kafka_streaming_lab
POSTGRES_PORT=5433
PURCHASES_DATABASE_URL=
LOYALTY_DATABASE_URL=
ANALYTICS_DATABASE_URL=
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Outbox Publishing Strategy: Debezium CDC only
# ─────────────────────────────────────────────────────────────────────────────
# No polling publisher or in-process relay is supported.

# ─────────────────────────────────────────────────────────────────────────────
# Debezium CDC Connect Infrastructure (Phase 5+)
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_CONNECT_PORT=8083
KAFKA_CONNECT_URL=http://localhost:8083
DEBEZIUM_CONNECT_IMAGE=debezium/connect:2.7.3.Final
CDC_CONNECTOR_NAME=purchases-outbox-connector
CDC_DATABASE_HOST=postgres
CDC_DATABASE_PORT=5432
CDC_SLOT_NAME=debezium_outbox_slot
CDC_PUBLICATION_NAME=debezium_outbox_pub
CDC_READY_TIMEOUT_MS=60000
PURCHASE_TOPIC_PARTITIONS=6

# ─────────────────────────────────────────────────────────────────────────────
# Prometheus & Grafana Monitoring (OBS-01+)
# ─────────────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_PORT=3005
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
HOST_DOCKER_INTERNAL=host.docker.internal

# Broker ingress monitoring (see SIMPLE-BROKER-MONITORING-PLAN.md)
BENCH_NETWORK_NAME=ingress-benchmark_default
# Official benchmark launcher: non-secret settings are in config/official-benchmark.json.
# Referenced by rabbitmq.passwordEnv; do not put real passwords in the JSON config.
BENCH_RABBITMQ_PASSWORD=guest
BENCH_KAFKA_BOOTSTRAP=kafka-bench:29092
BENCH_KAFKA_TOPIC_FILTER=^perf-.*
BENCH_REDIS_ADDR=redis://redis-bench:6379
BENCH_SCRAPE_INTERVAL=2s
BENCH_KAFKA_EXPORTER_TARGET=kafka-exporter:9308
BENCH_REDIS_EXPORTER_TARGET=redis-exporter:9121
BENCH_RABBITMQ_METRICS_TARGET=rabbitmq-bench:15692
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
PROMETHEUS_RETENTION_TIME=24h
PROMETHEUS_RETENTION_SIZE=512MB
MONITORING_LOG_MAX_SIZE=10m
MONITORING_LOG_MAX_FILES=3
# Real Application server push (transient PostgreSQL invalidations; no data polling)
UI_PUSH_PURCHASE_CHANNEL=real_app_purchases_v1
UI_PUSH_HEARTBEAT_MS=15000
UI_PUSH_RECONNECT_MS=1000
UI_PUSH_COALESCE_MS=25
UI_PUSH_MAX_CLIENTS=32

