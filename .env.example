# ─────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOYALTY_WORKER_PORT=3001
ANALYTICS_WORKER_PORT=3002
PUBLISHER_PORT=3003
REPLAY_WORKER_PORT=3004

# ─────────────────────────────────────────────────────────────────────────────
# Kafka Infrastructure (P0-02+)
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
KAFKA_CLUSTER_ID=4L622nShTUiAnsYh0-X41w
KAFKA_CLIENT_ID=producer-api
PURCHASE_TOPIC=purchase.events
KAFKA_LOYALTY_GROUP_ID=loyalty-v1
KAFKA_ANALYTICS_GROUP_ID=analytics-v1

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Phase 4+)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kafka_streaming_lab
POSTGRES_PORT=5432
PURCHASES_DATABASE_URL=
LOYALTY_DATABASE_URL=
ANALYTICS_DATABASE_URL=
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Outbox Publishing Strategy (Phase 4+)
# ─────────────────────────────────────────────────────────────────────────────
# false = Delegated to dedicated standalone outbox-publisher daemon (apps/outbox-publisher)
# true  = In-process relay inside producer-api (single-process dev/test only)
OUTBOX_RELAY_IN_PROCESS=false
